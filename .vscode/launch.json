{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Peepo: Windows simulator",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/peepo.exe",
      "cwd": "${workspaceFolder}/build",
      "preLaunchTask": "Peepo: build",
      "symbolSearchPath": "${workspaceFolder}/build/Debug",
      "requireExactSource": true,
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Peepo: domain and engine checks",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/peepo_core_tests.exe",
      "cwd": "${workspaceFolder}/build",
      "preLaunchTask": "Peepo: build",
      "symbolSearchPath": "${workspaceFolder}/build/Debug",
      "requireExactSource": true,
      "stopAtEntry": false,
      "externalConsole": false
    }
  ]
}
