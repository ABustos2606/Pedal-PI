# The audio server. Restarting it restarts the engine too (its client).
[Unit]
Description=Pedal PI audio server (JACK)
PartOf=pedalpi.target

[Service]
Type=simple
User=pedalpi
EnvironmentFile=/etc/pedalpi/pedalpi.conf
Environment=JACK_NO_AUDIO_RESERVATION=1
ExecStart=/usr/bin/jackd $JACK_OPTIONS -d $JACK_DRIVER $JACK_DRIVER_OPTIONS
# JACK is ready when it answers.
ExecStartPost=/bin/sh -c 'for i in $(seq 50); do jack_lsp >/dev/null 2>&1 && exit 0; sleep 0.1; done; exit 1'
LimitRTPRIO=95
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2
