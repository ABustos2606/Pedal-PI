# Keeps the engine wired to the audio interface, also after the engine or
# JACK restarts.
[Unit]
Description=Pedal PI audio connections
PartOf=pedalpi.target
After=pedalpi-engine.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pedalpi
EnvironmentFile=/etc/pedalpi/pedalpi.conf
ExecStart=/opt/pedalpi/bin/pedalpi-route
Restart=always
RestartSec=2
