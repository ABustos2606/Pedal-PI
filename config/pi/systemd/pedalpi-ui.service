# The touch interface. It only wants the engine: stopping or restarting it
# never touches the engine, and it reconnects by itself when the engine
# restarts.
[Unit]
Description=Pedal PI touch interface
PartOf=pedalpi.target
Wants=pedalpi-engine.service
After=pedalpi-engine.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pedalpi
StateDirectory=pedalpi
EnvironmentFile=/etc/pedalpi/pedalpi.conf
ExecStart=/opt/pedalpi/bin/pedal_pi --engine unix:///run/pedalpi/ingen.sock --patches /var/lib/pedalpi/patches --controls /etc/pedalpi/controls.conf $UI_OPTIONS
Restart=always
RestartSec=1
