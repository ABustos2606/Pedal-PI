# Keeps the engine wired to the audio interface, also after the engine or
# JACK restarts.
[Unit]
Description=Peepo audio connections
PartOf=peepo.target
After=peepo-engine.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=peepo
EnvironmentFile=/etc/peepo/peepo.conf
ExecStart=/opt/peepo/bin/peepo-route
Restart=always
RestartSec=2
