# The audio engine. Bound to JACK, independent of the interface: the
# interface can stop, crash or restart while the engine keeps playing.
[Unit]
Description=Pedal PI audio engine (Ingen)
PartOf=pedalpi.target
BindsTo=pedalpi-jack.service
After=pedalpi-jack.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pedalpi
RuntimeDirectory=pedalpi
StateDirectory=pedalpi
ExecStart=/opt/pedalpi/bin/pedalpi-engine
ExecStartPost=/bin/sh -c 'for i in $(seq 100); do [ -S /run/pedalpi/ingen.sock ] && exit 0; sleep 0.1; done; exit 1'
LimitRTPRIO=95
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2
