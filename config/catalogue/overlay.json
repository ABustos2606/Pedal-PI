{
  "format": "pedalpi-catalogue-overlay",
  "version": 1,
  "rules": [
    {"match": "polyeffects.com/lv2/", "strip_prefix": "Poly "},
    {"match": "polyclouds", "category": "Texture", "parameters": [
      {"symbol": "in_gain_param", "hidden": true},
      {"symbol": "pitch_param", "kind": "integer", "unit": "st", "default": 0},
      {"symbol": "freeze_param", "kind": "toggle", "default": 0},
      {"symbol": "reverse_param", "kind": "toggle", "default": 0}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#granular", "name": "Clouds", "description": "Granular texture from the live input. Freeze holds the buffer; blend at 0 is the dry signal, about 9 dB down.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param"}, {"symbol": "density_param"}, {"symbol": "texture_param"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#stretch", "name": "Clouds Stretch", "category": "Pitch", "description": "Clouds' pitch-shifter and time-stretcher.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param"}, {"symbol": "pitch_param"}, {"symbol": "blend_param"},
      {"symbol": "density_param", "name": "Diffusion"}, {"symbol": "texture_param", "name": "Filter"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#looping_delay", "name": "Clouds Looper", "category": "Delay", "description": "Clouds' looping delay with pitch shifting. Freeze loops what is in the buffer.", "parameters": [
      {"symbol": "position_param", "name": "Tape length"}, {"symbol": "size_param", "name": "Pitch window"}, {"symbol": "pitch_param"}, {"symbol": "blend_param"},
      {"symbol": "density_param", "name": "Diffusion"}, {"symbol": "texture_param", "name": "Filter"}, {"symbol": "freeze_param", "name": "Loop"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#spectral", "name": "Clouds Spectral", "description": "Clouds' spectral processor. Not offered by Beebo; names follow the firmware source.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param", "name": "Warp"}, {"symbol": "density_param", "name": "Refresh"}, {"symbol": "texture_param", "name": "Quantize"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#oliverb", "name": "Oliverb", "category": "Reverb", "description": "Parasites' Oliverb reverb with pitch-shifted, modulated tails. Hold sustains the tail.", "parameters": [
      {"symbol": "position_param", "name": "Pre-delay"}, {"symbol": "size_param"}, {"symbol": "density_param", "name": "Decay"}, {"symbol": "texture_param", "name": "Damp"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param", "name": "Hold"}, {"symbol": "spread_param", "name": "Diffusion"},
      {"symbol": "feedback_param", "name": "Mod speed"}, {"symbol": "reverb_param", "name": "Mod amount"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#resonestor", "name": "Resonestor", "category": "Resonator", "description": "Parasites' two-voice, four-part resonator played by the input.", "parameters": [
      {"symbol": "position_param", "name": "Timbre"}, {"symbol": "size_param", "name": "Chord"}, {"symbol": "density_param", "name": "Decay"}, {"symbol": "texture_param", "name": "Filter"},
      {"symbol": "pitch_param"}, {"symbol": "feedback_param", "name": "Harmonics"}, {"symbol": "reverb_param", "name": "Scatter"}, {"symbol": "freeze_param", "name": "Switch voice"},
      {"symbol": "spread_param"}, {"symbol": "blend_param", "name": "Random mod"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#beat_repeat", "name": "Clouds Beat Repeat", "category": "Delay"},
    {"match": "polywarps", "category": "Modulation"},
    {"match": "polyplaits", "category": "Sound source"},
    {"match": "polyrings", "category": "Resonator"},
    {"uri": "http://polyeffects.com/lv2/polyrings", "name": "Resonator", "description": "Upstream names this module \"Random CV Sampler\", as it does the random source"},
    {"uri": "http://polyeffects.com/lv2/polyplaits", "name": "Plaits"},
    {"uri": "http://polyeffects.com/lv2/polygrids", "name": "Grids", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/polymarbles", "name": "Marbles", "category": "Control", "description": "Upstream names this module \"Random CV Sampler\""},
    {"uri": "http://polyeffects.com/lv2/polytides", "name": "Tides", "category": "Control"},
    {"match": "drobilla.net/plugins/mda/", "strip_prefix": "MDA "},
    {"uri": "http://drobilla.net/plugins/mda/Ambience", "category": "Reverb", "description": "Adds a small-room reverb around the input."},
    {"uri": "http://drobilla.net/plugins/mda/Bandisto", "category": "Drive", "description": "Distortion with separate low, middle and high bands."},
    {"uri": "http://drobilla.net/plugins/mda/BeatBox", "category": "Sound source", "description": "Triggers synthesized drum sounds from incoming audio."},
    {"uri": "http://drobilla.net/plugins/mda/Combo", "category": "Amp", "description": "A conventional guitar amp and speaker simulation; no model file needed."},
    {"uri": "http://drobilla.net/plugins/mda/DeEss", "category": "Dynamics", "description": "Reduces harsh high-frequency peaks."},
    {"uri": "http://drobilla.net/plugins/mda/Degrade", "category": "Drive", "description": "Lo-fi distortion through reduced sample rate and resolution."},
    {"uri": "http://drobilla.net/plugins/mda/Delay", "category": "Delay", "description": "Stereo echo with feedback and filtering."},
    {"uri": "http://drobilla.net/plugins/mda/Detune", "category": "Pitch", "description": "Small pitch offsets for doubling and thickening."},
    {"uri": "http://drobilla.net/plugins/mda/DubDelay", "category": "Delay", "description": "Modulated echo with feedback for dub-style repeats."},
    {"uri": "http://drobilla.net/plugins/mda/Dynamics", "category": "Dynamics", "description": "Compressor, limiter and gate for controlling signal level."},
    {"uri": "http://drobilla.net/plugins/mda/Leslie", "category": "Modulation", "description": "Rotating speaker simulation."},
    {"uri": "http://drobilla.net/plugins/mda/Limiter", "category": "Dynamics", "description": "Limits loud peaks."},
    {"uri": "http://drobilla.net/plugins/mda/Loudness", "category": "Dynamics", "description": "Changes perceived loudness with level-dependent filtering."},
    {"uri": "http://drobilla.net/plugins/mda/MultiBand", "category": "Dynamics", "description": "Compresses low, middle and high frequency bands separately."},
    {"uri": "http://drobilla.net/plugins/mda/Overdrive", "category": "Drive", "description": "Soft-clipping distortion with tone and level controls."},
    {"uri": "http://drobilla.net/plugins/mda/RePsycho", "category": "Pitch", "description": "Audio-triggered pitch shifting and sample playback."},
    {"uri": "http://drobilla.net/plugins/mda/RezFilter", "category": "Filter", "description": "Resonant filter with envelope and LFO modulation."},
    {"uri": "http://drobilla.net/plugins/mda/RingMod", "category": "Modulation", "description": "Ring modulation for metallic, bell-like tones."},
    {"uri": "http://drobilla.net/plugins/mda/RoundPan", "category": "Modulation", "description": "Moves the sound between left and right."},
    {"uri": "http://drobilla.net/plugins/mda/Shepard", "category": "Pitch", "description": "Shepard-tone processing for an endlessly rising or falling illusion."},
    {"uri": "http://drobilla.net/plugins/mda/SubSynth", "category": "Pitch", "description": "Adds synthesized low-frequency content below the input."},
    {"uri": "http://drobilla.net/plugins/mda/TalkBox", "category": "Filter", "description": "Shapes a carrier with another signal; needs both audio inputs connected."},
    {"uri": "http://drobilla.net/plugins/mda/ThruZero", "category": "Modulation", "description": "Through-zero flanging."},
    {"uri": "http://drobilla.net/plugins/mda/Tracker", "category": "Sound source", "description": "Pitch-tracking oscillator played by incoming audio."},
    {"uri": "http://drobilla.net/plugins/mda/Transient", "category": "Dynamics", "description": "Reshapes the attack and sustain of the input."},
    {"uri": "http://drobilla.net/plugins/mda/VocInput", "category": "Filter", "description": "Prepares a voice or other input for a vocoder."},
    {"uri": "http://drobilla.net/plugins/mda/Vocoder", "category": "Filter", "description": "Shapes a carrier with another signal; needs both audio inputs connected."},
    {"uri": "http://drobilla.net/plugins/mda/TestTone", "category": "Sound source", "description": "Generates test tones for checking a patch."},
    {"uri": "http://drobilla.net/plugins/mda/DX10", "category": "Sound source", "availability": "untested", "reason": "FM instrument; needs MIDI notes. MIDI routing is not implemented yet."},
    {"uri": "http://drobilla.net/plugins/mda/EPiano", "category": "Sound source", "availability": "untested", "reason": "Electric piano instrument; needs MIDI notes. MIDI routing is not implemented yet."},
    {"uri": "http://drobilla.net/plugins/mda/JX10", "category": "Sound source", "availability": "untested", "reason": "Synthesizer; needs MIDI notes. MIDI routing is not implemented yet."},
    {"uri": "http://drobilla.net/plugins/mda/Piano", "category": "Sound source", "availability": "untested", "reason": "Piano instrument; needs MIDI notes. MIDI routing is not implemented yet."},
    {"match": "lv2plug.in/plugins/eg-", "strip_prefix": "Example "},
    {"uri": "http://lv2plug.in/plugins/eg-amp", "name": "Gain", "category": "Utility", "description": "Changes signal level. This is a gain control, not an amp simulation."},

