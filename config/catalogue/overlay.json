    {"match": "polyeffects.com/lv2/polyconvo#", "availability": "untested", "reason": "Needs an impulse response file, and the interface cannot choose one yet (P8.3)."},
    {"match": "gareus.org/oss/lv2/convoLV2#", "availability": "untested", "reason": "Needs an impulse response file, and the interface cannot choose one yet (P8.3)."},
