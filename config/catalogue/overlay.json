{
  "format": "pedalpi-catalogue-overlay",
  "version": 1,
  "rules": [
    {"match": "polyeffects.com/lv2/", "strip_prefix": "Poly "},
    {"match": "polyclouds", "category": "Texture", "parameters": [
      {"symbol": "in_gain_param", "hidden": true},
      {"symbol": "pitch_param", "kind": "integer", "unit": "st", "default": 0},
      {"symbol": "freeze_param", "kind": "toggle", "default": 0},
      {"symbol": "reverse_param", "kind": "toggle", "default": 0}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#granular", "name": "Clouds", "description": "Granular texture from the live input. Freeze holds the buffer; blend at 0 is the dry signal, about 9 dB down.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param"}, {"symbol": "density_param"}, {"symbol": "texture_param"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#stretch", "name": "Clouds Stretch", "category": "Pitch", "description": "Clouds' pitch-shifter and time-stretcher.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param"}, {"symbol": "pitch_param"}, {"symbol": "blend_param"},
      {"symbol": "density_param", "name": "Diffusion"}, {"symbol": "texture_param", "name": "Filter"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#looping_delay", "name": "Clouds Looper", "category": "Delay", "description": "Clouds' looping delay with pitch shifting. Freeze loops what is in the buffer.", "parameters": [
      {"symbol": "position_param", "name": "Tape length"}, {"symbol": "size_param", "name": "Pitch window"}, {"symbol": "pitch_param"}, {"symbol": "blend_param"},
      {"symbol": "density_param", "name": "Diffusion"}, {"symbol": "texture_param", "name": "Filter"}, {"symbol": "freeze_param", "name": "Loop"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#spectral", "name": "Clouds Spectral", "description": "Clouds' spectral processor. Not offered by Beebo; names follow the firmware source.", "parameters": [
      {"symbol": "position_param"}, {"symbol": "size_param", "name": "Warp"}, {"symbol": "density_param", "name": "Refresh"}, {"symbol": "texture_param", "name": "Quantize"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#oliverb", "name": "Oliverb", "category": "Reverb", "description": "Parasites' Oliverb reverb with pitch-shifted, modulated tails. Hold sustains the tail.", "parameters": [
      {"symbol": "position_param", "name": "Pre-delay"}, {"symbol": "size_param"}, {"symbol": "density_param", "name": "Decay"}, {"symbol": "texture_param", "name": "Damp"},
      {"symbol": "pitch_param"}, {"symbol": "blend_param"}, {"symbol": "freeze_param", "name": "Hold"}, {"symbol": "spread_param", "name": "Diffusion"},
      {"symbol": "feedback_param", "name": "Mod speed"}, {"symbol": "reverb_param", "name": "Mod amount"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#resonestor", "name": "Resonestor", "category": "Resonator", "description": "Parasites' two-voice, four-part resonator played by the input.", "parameters": [
      {"symbol": "position_param", "name": "Timbre"}, {"symbol": "size_param", "name": "Chord"}, {"symbol": "density_param", "name": "Decay"}, {"symbol": "texture_param", "name": "Filter"},
      {"symbol": "pitch_param"}, {"symbol": "feedback_param", "name": "Harmonics"}, {"symbol": "reverb_param", "name": "Scatter"}, {"symbol": "freeze_param", "name": "Switch voice"},
      {"symbol": "spread_param"}, {"symbol": "blend_param", "name": "Random mod"}, {"symbol": "reverse_param"}
    ]},
    {"uri": "http://polyeffects.com/lv2/polyclouds#beat_repeat", "name": "Clouds Beat Repeat", "category": "Delay"},
    {"match": "polywarps", "category": "Modulation"},
    {"match": "polyplaits", "category": "Sound source"},
    {"match": "polyrings", "category": "Resonator"},
    {"uri": "http://polyeffects.com/lv2/polyrings", "name": "Resonator", "description": "Upstream names this module \"Random CV Sampler\", as it does the random source"},
    {"uri": "http://polyeffects.com/lv2/polyplaits", "name": "Plaits"},
    {"uri": "http://polyeffects.com/lv2/polygrids", "name": "Grids", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/polymarbles", "name": "Marbles", "category": "Control", "description": "Upstream names this module \"Random CV Sampler\""},
    {"uri": "http://polyeffects.com/lv2/polytides", "name": "Tides", "category": "Control"},
    {"match": "drobilla.net/plugins/mda/", "strip_prefix": "MDA "},
    {"match": "lv2plug.in/plugins/eg-", "strip_prefix": "Example "},
    {"uri": "http://lv2plug.in/plugins/eg-amp", "name": "Amp"},

    {"match": "polyeffects.com/lv2/basic_modular#", "category": "Utility"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#abs", "name": "Absolute"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#boost", "name": "Boost"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#difference", "name": "Difference"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#max", "name": "Maximum"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#min", "name": "Minimum"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#product", "name": "Product"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#ratio", "name": "Ratio"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#sum", "name": "Sum"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#clock_divider", "name": "Clock divider", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#schmitt", "name": "CV to trigger", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#toggle", "name": "Toggle", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/basic_modular#trigger_to_gate", "name": "Trigger to gate", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/basic_quantizer", "name": "Quantizer", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/bitcrushed_delay", "name": "Bitcrushed delay", "category": "Delay"},
    {"uri": "http://polyeffects.com/lv2/chorus", "name": "Chorus", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/chorus_ext", "name": "Chorus (CV)", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/flanger", "name": "Flanger", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/flanger_ext", "name": "Flanger (CV)", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/harm_trem", "name": "Harmonic tremolo", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/harm_trem_ext", "name": "Harmonic tremolo (CV)", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/vibrato", "name": "Vibrato", "category": "Modulation"},
    {"uri": "http://polyeffects.com/lv2/vibrato_ext", "name": "Vibrato (CV)", "category": "Modulation"},
    {"match": "polyeffects.com/lv2/euclidean", "name": "Euclidean", "category": "Control"},
    {"match": "polyeffects.com/lv2/note_sequencer", "category": "Control"},
    {"match": "polyeffects.com/lv2/step_sequencer", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/strum", "name": "Strum", "category": "Control"},
    {"uri": "http://polyeffects.com/lv2/mclk_in", "name": "MIDI clock in", "category": "Control"},
    {"match": "polyeffects.com/lv2/cv_to_", "category": "Utility"},
    {"uri": "http://polyeffects.com/lv2/pitch_cal#in", "name": "Pitch calibration in"},
    {"uri": "http://polyeffects.com/lv2/pitch_cal#out", "name": "Pitch calibration out"},
    {"match": "polyeffects.com/lv2/polyfilter#", "category": "Filter"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#diode_ladder", "name": "Diode ladder"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#korg_hpf", "name": "Korg 35 high-pass"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#korg_lpf", "name": "Korg 35 low-pass"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#moog_half_ladder", "name": "Moog half ladder"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#moog_ladder", "name": "Moog ladder"},
    {"uri": "http://polyeffects.com/lv2/polyfilter#oberheim", "name": "Oberheim filter"},
    {"match": "polyeffects.com/lv2/polyconvo#Cab", "category": "Cabinet", "strip_prefix": "Convolver "},
    {"uri": "http://polyeffects.com/lv2/polyconvo#Mono", "name": "IR reverb mono", "category": "Reverb"},
    {"uri": "http://polyeffects.com/lv2/polyconvo#MonoToStereo", "name": "IR reverb mono to stereo", "category": "Reverb"},
    {"uri": "http://polyeffects.com/lv2/polyconvo#Stereo", "name": "IR reverb stereo", "category": "Reverb"},
    {"match": "gareus.org/oss/lv2/convoLV2#", "category": "Reverb"},
    {"match": "gareus.org/oss/lv2/tuna#", "name": "Tuner", "category": "Utility"},
    {"uri": "http://gareus.org/oss/lv2/tuna#two", "name": "Tuner (spectrum)"},
    {"uri": "http://gareus.org/oss/lv2/tuna#one", "availability": "untested", "reason": "The same tuner as the MOD build Beebo uses, which is offered."},

    {"match": "avwlv2.sourceforge.net/plugins/avw/", "strip_prefix": "AMS ", "category": "Utility"},
    {"match": "avwlv2.sourceforge.net/plugins/avw/vcf", "category": "Filter"},
    {"match": "avwlv2.sourceforge.net/plugins/avw/mooglpf", "category": "Filter"},
