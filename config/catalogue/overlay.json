    {"match": "drobilla.net/plugins/blop/", "category": "Control"},
    {"uri": "http://calf.sourceforge.net/plugins/Vinyl", "name": "Vinyl", "category": "Texture"},
    {"uri": "http://distrho.sf.net/plugins/MVerb", "category": "Reverb"},
    {"match": "gareus.org/oss/lv2/b_whirl#", "category": "Modulation"},
    {"uri": "http://gareus.org/oss/lv2/b_whirl#simple", "name": "Rotary speaker"},
    {"uri": "http://gareus.org/oss/lv2/b_whirl#extended", "name": "Rotary speaker (full)"},
    {"uri": "http://gareus.org/oss/lv2/darc#mono", "name": "Compressor"},
    {"uri": "http://gareus.org/oss/lv2/darc#stereo", "name": "Compressor stereo"},
    {"uri": "http://gareus.org/oss/lv2/fil4#mono", "name": "Parametric EQ"},
    {"uri": "http://gareus.org/oss/lv2/fil4#stereo", "name": "Parametric EQ stereo"},
    {"match": "gareus.org/oss/lv2/zeroconvolv#", "strip_prefix": "x42 - "},
    {"match": "guitarix.sourceforge.net/plugins/", "category": "Amp", "strip_prefix": "Gx"},
    {"uri": "http://guitarix.sourceforge.net/plugins/gx_slowgear_#_slowgear_", "name": "Slow gear", "category": "Dynamics"},
    {"uri": "http://guitarix.sourceforge.net/plugins/gx_ampegsvt_#_ampegsvt_", "name": "Bass amp (SVT)"},
    {"uri": "http://guitarix.sourceforge.net/plugins/gx_CreamMachine_#_CreamMachine_", "name": "Power amp (Cream)"},
    {"uri": "http://guitarix.sourceforge.net/plugins/gx_supersonic_#_supersonic_", "name": "Power amp (Supersonic)"},
    {"uri": "http://github.com/mikeoliphant/neural-amp-modeler-lv2", "name": "NAM", "category": "Amp", "availability": "untested", "reason": "Needs a model file, and the interface cannot choose one yet (P8.3)."},
    {"match": "jpcima.sdf1.org/lv2/stone-phaser", "category": "Modulation"},
    {"match": "moddevices.com/plugins/tap/", "strip_prefix": "TAP "},
    {"uri": "http://moddevices.com/plugins/tap/reflector", "name": "Reverse (Reflector)", "category": "Texture"},
    {"uri": "http://moddevices.com/plugins/tap/tubewarmth", "category": "Drive"},
    {"match": "ssj71.github.io/infamousPlugins/", "strip_prefix": "the infamous "},
    {"uri": "http://ssj71.github.io/infamousPlugins/plugs.html#envfollowerCV", "name": "Envelope follower", "category": "Control"},
    {"uri": "http://ssj71.github.io/infamousPlugins/plugs.html#stuck", "name": "Stuck (freeze)", "category": "Texture"},
    {"uri": "http://ssj71.github.io/infamousPlugins/plugs.html#powercut", "name": "Power cut", "category": "Texture"},
