diff --git a/include/ingen/SocketWriter.hpp b/include/ingen/SocketWriter.hpp
--- a/include/ingen/SocketWriter.hpp
+++ b/include/ingen/SocketWriter.hpp
@@ -57,6 +57,7 @@ public:
 
 protected:
 	std::shared_ptr<raul::Socket> _socket;
+	unsigned _bundle_depth = 0;
 };
 
 } // namespace ingen
diff --git a/src/SocketWriter.cpp b/src/SocketWriter.cpp
--- a/src/SocketWriter.cpp
+++ b/src/SocketWriter.cpp
@@ -49,7 +49,13 @@ SocketWriter::message(const Message& message)
 {
+	if (std::get_if<BundleBegin>(&message)) {
+		++_bundle_depth;
+	}
 	TurtleWriter::message(message);
-	if (std::get_if<BundleEnd>(&message)) {
-		// Send a null byte to indicate end of bundle
+	if (std::get_if<BundleEnd>(&message) && _bundle_depth) {
+		--_bundle_depth;
+	}
+	if (!_bundle_depth) {
+		// Frame standalone notifications as well as complete outer bundles.
 		const char end[] = { 0 };
 		send(_socket->fd(), end, 1, MSG_NOSIGNAL);
 	}
