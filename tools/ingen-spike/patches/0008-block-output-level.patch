+/** Peepo: scale the audio outputs to the block's output level, ramping across
+    the cycle so a change never clicks. Not applied while bypassed: a bypassed
+    block passes its input through unchanged. */
+void
+BlockImpl::apply_output_gain(RunContext& ctx)
+{
+	const float from = _output_gain_now;
+	const float to   = _output_gain;
+	if (from == 1.0f && to == 1.0f) {
+		return;
+	}
+
+	const SampleCount n = ctx.nframes();
+	for (uint32_t i = 0; _ports && i < _ports->size(); ++i) {
+		PortImpl* const port = _ports->at(i);
+		if (port->type() != PortType::AUDIO || !port->is_output()) {
+			continue;
+		}
+		for (uint32_t v = 0; v < _polyphony; ++v) {
+			Sample* const s = port->buffer(v)->samples();
+			for (SampleCount f = 0; f < n; ++f) {
+				s[f] *= from + (to - from) * static_cast<float>(f + 1) / static_cast<float>(n);
+			}
+		}
+	}
+	_output_gain_now = to;
+}
